<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.FFTT04M" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Dark window background so the (now transparent) system-bar gutters are black, not the
             DayNight default white that showed through under edge-to-edge on Android 15+. -->
        <item name="android:windowBackground">@android:color/black</item>
        <!-- Transparent system bars (light icons over the black UI), no auto contrast scrim. The
             statusBarColor attrs are ignored under forced edge-to-edge on API 35+, but kept for
             older devices; the black windowBackground is what makes the gutter dark either way. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <!-- Force dark mode -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">true</item>
    </style>
</resources>